{
    "name": "y-webtorrent",
    "version": "0.1.0",
    "description": "Yjs provider using WebTorrent tracker signaling and WebRTC data channels",
    "license": "ISC",
    "author": "",
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.json",
        "prepare": "npm run build",
        "dev": "vite examples/browser-smoke --host 0.0.0.0",
        "format": "oxfmt --write .",
        "lint": "oxlint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "check": "npm run lint && npm run typecheck && npm test",
        "test": "npm run build && node --test"
    },
    "dependencies": {
        "lib0": "^0.2.117",
        "webrtc-data-peer": "git+https://github.com/woohp/webrtc-data-peer.git#a8a999d",
        "y-protocols": "^1.0.7",
        "yjs": "^13.6.31"
    },
    "devDependencies": {
        "oxfmt": "^0.58.0",
        "oxlint": "^1.73.0",
        "typescript": "^7.0.2",
        "vite": "^8.1.4"
    }
}
